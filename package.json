{
  "name": "ssn-desktop-overlay",
  "version": "0.1.0",
  "description": "Transparent always-on-top desktop overlay for Social Stream Ninja chat + activity feed",
  "main": "main.js",
  "author": "Michal Galewski (thepolishdane)",
  "license": "MIT",
  "scripts": {
    "start": "node launch.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thepolishdane.ssn-overlay",
    "productName": "SSN Overlay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "launch.js",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "config.example.json",
        "to": "config.json"
      },
      {
        "from": "README.txt",
        "to": "README.txt"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    }
  }
}
